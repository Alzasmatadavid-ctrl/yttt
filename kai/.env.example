# ─────────────────────────────────────────────────────────────────────────────
#  KAI · Archivo de configuración
#
#  Cómo usarlo:
#    1. Copia este archivo y llámalo ".env" (en esta misma carpeta /kai).
#    2. Rellena solo lo que necesites. KAI arranca SIN ninguna clave:
#       - sin base de datos usa una local (se guarda en backend/.data/),
#       - sin clave de IA funciona en "modo simulado" (respuestas por reglas),
#       - sin Meta/Google/Calendly esas integraciones aparecen como "no configuradas".
#    3. Nunca subas el archivo .env a GitHub (ya está ignorado).
#
#  Dónde conseguir cada clave: docs/INTEGRACIONES.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
# Modo de ejecución: development (por defecto, en tu ordenador) o production (en el servidor).
# Déjalo comentado: con Docker (Dockerfile o docker-compose.yml) ya se fija production solo, y si lo
# descomentas aquí con otro valor, "docker run --env-file .env" lo usaría en lugar del de la imagen.
# Descoméntalo solo si arrancas en un servidor sin Docker con "npm start".
# NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Proxies de confianza delante de KAI, para conocer la IP real de cada visitante (límites de
# intentos de login, formularios…). Déjalo vacío: en producción se confía en los proxies de redes
# privadas (Railway, Render, Docker, Caddy en la misma máquina) y en tu ordenador en ninguno.
#   false = KAI recibe las conexiones directamente, sin proxy.
#   Un número (1, 2…) = cuántos proxies hay delante (solo si KAI no es accesible sin pasar por ellos).
#   IPs o rangos separados por comas = las direcciones de tus proxies (p. ej. los de Cloudflare).
TRUST_PROXY=

# Dirección pública donde se abre la app.
#   En local: http://localhost:5173  ·  En producción: https://app.tudominio.com
APP_URL=http://localhost:5173
# Dirección pública del servidor (webhooks y Google). Déjalo vacío si es la misma que APP_URL
# (en producción con Docker lo es). En local con túnel (ngrok…) pon aquí la URL del túnel.
API_URL=

# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL. OBLIGATORIA en producción (Neon, Supabase, Railway…).
# Ejemplo: postgres://usuario:contraseña@host:5432/kai?sslmode=require
# Vacía = base de datos local embebida (solo para probar en tu ordenador).
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Solo si usas docker-compose.yml (Postgres incluido): contraseña de esa base de datos.
POSTGRES_PASSWORD=

# Clave para cifrar los tokens de WhatsApp, Instagram, Google… OBLIGATORIA en producción.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala bien: si la pierdes tendrás que volver a conectar las integraciones.
ENCRYPTION_KEY=

# ── Inteligencia artificial (Claude, de Anthropic) ───────────────────────────
# auto = usa Claude si hay clave; si no, modo simulado.  anthropic | simulated para forzarlo.
AI_PROVIDER=auto
# Clave de https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelos (no hace falta cambiarlos).
AI_MODEL_MAIN=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-4-5
# Cuánto "piensa" KAI antes de responder: low (más rápido y barato) | medium | high
AI_SETTER_EFFORT=low
AI_COPILOT_EFFORT=medium
# Segunda revisión de cada mensaje por un modelo rápido antes de enviarlo (recomendado).
AI_JUDGE_ENABLED=true
# Si el modelo principal está saturado, Anthropic usa otro automáticamente.
AI_SERVER_FALLBACKS=true

# ── Meta: WhatsApp Business, Instagram y Lead Ads ────────────────────────────
# De https://developers.facebook.com → tu app → Configuración → Básica
META_APP_ID=
META_APP_SECRET=
# Una palabra secreta que inventas tú y que pegarás también en Meta al configurar el webhook.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ── Google Calendar ──────────────────────────────────────────────────────────
# De https://console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth
# URI de redirección autorizada que debes añadir allí:  <API_URL o APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (recuperar contraseña e invitaciones al equipo) ────────────────────
# console = los emails se muestran en la consola del servidor (solo para probar en tu ordenador;
#           en producción NO se usa: sin Resend no se envía ningún email).
# resend  = se envían de verdad con https://resend.com (necesario en producción).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=KAI <no-reply@tudominio.com>

# ── Automatizaciones (recordatorios, seguimientos, respuestas de KAI) ────────
# true = el propio servidor procesa la cola cada pocos segundos (recomendado).
RUN_WORKER=true
WORKER_INTERVAL_MS=2000
# Opcional: si tu hosting "duerme" el servidor, un cron externo puede llamar a
# POST <APP_URL>/api/internal/cron con la cabecera  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Administración del SaaS ─────────────────────────────────────────────────
# Tu cuenta de propietario de KAI (panel /admin). Se crea al arrancar si no existe y si
# ADMIN_PASSWORD está rellena. Registrarse en la web con ese email NO da acceso al panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Solo si ya tenías una cuenta normal con ADMIN_EMAIL y quieres convertirla en la de
# administración: pon true, arranca una vez y vuelve a dejarlo en false.
ADMIN_PROMOTE_EXISTING=false

# ── Formularios públicos de tu web (anti-spam) ───────────────────────────────
# Leads nuevos que acepta el formulario público de cada negocio por hora y por día.
PUBLIC_FORM_MAX_PER_HOUR=30
PUBLIC_FORM_MAX_PER_DAY=200

# ── Datos de demostración (npm run db:seed) ──────────────────────────────────
# Usa un email que no sea el de ninguna cuenta real (ni ADMIN_EMAIL). En producción el seed
# exige --force y una DEMO_PASSWORD propia (la de ejemplo es pública).
DEMO_EMAIL=demo@kai.local
DEMO_PASSWORD=KaiDemo2026

# ── Aplicación web ───────────────────────────────────────────────────────────
# true = el servidor también sirve la web. Por defecto es false (en tu ordenador la web la sirve "npm run dev"
# en el puerto 5173). Con Docker ya se pone a true solo: déjalo comentado por el mismo motivo que NODE_ENV.
# Descoméntalo solo si arrancas en un servidor sin Docker con "npm start".
# SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

# Nivel de detalle de los registros: error | warn | info | debug
LOG_LEVEL=info
